{
  "appId": "com.littleridgeestate.valleyestates",
  "appName": "Valley Estates",
  "webDir": "www",
  "backgroundColor": "#f4f1e8",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "allowsInlineMediaPlayback": true,
    "limitsNavigationsToAppBoundDomains": false
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "allowNavigation": []
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 0,
      "backgroundColor": "#f4f1e8",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#00000000"
    }
  }
}
