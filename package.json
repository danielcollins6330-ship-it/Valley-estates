{
  "name": "valley-estates",
  "version": "1.0.0",
  "private": true,
  "description": "Valley Estates — a Ferguson Valley farming strategy game",
  "scripts": {
    "www": "node scripts/sync-www.mjs",
    "sync": "node scripts/sync-www.mjs && cap sync",
    "assets": "node scripts/generate-brand.mjs",
    "android:aab": "npm run sync && cd android && ./gradlew bundleRelease",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "foldable": "node scripts/capture-foldable.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:audio": "node --test scripts/audio*.test.mjs",
    "web:stage": "node scripts/stage-web.mjs _site"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/ios": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@resvg/resvg-js": "2.6.2",
    "puppeteer-core": "25.15.0",
    "sharp": "^0.32.6"
  }
}
